PORT=5000

# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/sweeterjoy

# Cloudinary (sign up free at cloudinary.com -> Dashboard)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Any long random string
JWT_SECRET=change_this_to_a_long_random_string

# Your React app's URL (for CORS)
FRONTEND_URL=http://localhost:8443

# Used only by the seed:admin script to create the first admin account
SEED_ADMIN_NAME=admin
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD=change_this_password

# Gmail account used to SEND otp emails (not the admin's login email)
# SMTP_APP_PASSWORD is a Gmail "App Password", not your normal Gmail password —
# generate one at https://myaccount.google.com/apppasswords (needs 2FA enabled)
SMTP_EMAIL=your_sender_gmail@gmail.com
SMTP_APP_PASSWORD=your_16_char_app_password
